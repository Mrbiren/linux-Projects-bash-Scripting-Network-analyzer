# Practical 3A  Utilities and Auditing:  Fixers Utilities 

import datetime as dt

print("===============Removing unnecessary spaces=================")
baddata = "  Data having too many space is bad data  "
print(f"Bad Data : <{baddata}>")
gooddata = baddata.strip()
print(f"Good Data : <{gooddata}>")

print("===========Removing non-printable characters==============")
baddata = "Data having \x05unwanted funny \x02characters is bad!!!!"
print(f"Bad Data : <{repr(baddata)}>")
gooddata = "".join(char for char in baddata if char.isprintable())
print(f"Good Data : <{gooddata}>")

print("===========Reframing data================") 
originaldate=dt.date(2026,10,2) 
baddata=originaldate.strftime("%y-%m-%d") 
print(f"Bad data : <{baddata}>") 
gooddata=originaldate.strftime("%d %B %y") 
print(f"Good Data : <{gooddata}>")


