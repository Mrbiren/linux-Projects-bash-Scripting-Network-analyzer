# 4B. Generate XOR function using McCulloch-Pitts neural net.
def neuron(inputs, weights, threshold):
total = sum(x * w for x, w in zip(inputs, weights))

if total >= threshold:
return 1
else:
return 0


def AND(A, B):
return neuron([A, B], [1, 1], 2)


def OR(A, B):
return neuron([A, B], [1, 1], 1)


def NOT(A):
