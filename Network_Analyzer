# 8 Write a program to implement the Kohonen Self-organizing map.

import numpy as np

data = np.array([
[1,1],
[1,2],
[5,5],
[6,5]
])

weights = np.array([
[1,1],
[5,5]
],dtype=float)

learning_rate =0.5

for x in data:
distance = np.linalg.norm(weights -x, axis=1)

winner = np.argmin(distance)

weights[winner]= weights[winner]+learning_rate*(x-weights[winner])

print("Final Weights:")
print(weights)

new_data = np.array([1,2])
distance = np.linalg.norm(weights - new_data,axis=1)
winner=np.argmin(distance)
print("\nNew Input:", new_data)
print("Winning Neuron:",winner+1)


