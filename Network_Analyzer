# 2A. Create a perceptron with an appropriate number of inputs and outputs. Train it using a fixed increment learning algorithm until no change in weights is required. Output the final weights
n = int(input("Enter number of inputs: "))
samples = int(input("Enter number of training samples: "))
learning_rate = float(input("Enter learning rate: "))

X = []
T = []

print("\nEnter training data:")

for i in range(samples):
values = list(map(int, input(f"Input for sample {i+1}: ").split()))

if len(values) != n:
print("Invalid number of inputs!")
exit()

target = int(input(f"Target for sample {i+1}: "))

X.append(values)
T.append(target)

Weights = [0] * n
bias = 0
epoch = 0

def step_function(value):
return 1 if value >= 0 else 0

while True:
epoch += 1
changes = 0

for i in range(samples):
net = bias

for j in range(n):
net += Weights[j] * X[i][j]

output = step_function(net)
error = T[i] - output

if error != 0:
for j in range(n):
Weights[j] += learning_rate * error * X[i][j]

bias += learning_rate * error
changes += 1

if changes == 0:
break

print("\n=================================")
print("PERCEPTRON TRAINING COMPLETE")
print("EPOCHS:", epoch)

for i in range(n):
print(f"Weight {i+1}:", Weights[i])

print("BIAS:", bias)

print("\nTesting trained perceptron:")

for i in range(samples):
net = bias

for j in range(n):
net += Weights[j] * X[i][j]

result = step_function(net)

print("Input:", X[i], "Target:", T[i], "Output:", result)

