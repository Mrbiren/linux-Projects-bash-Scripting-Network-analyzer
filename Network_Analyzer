Practical 8B  Organising Data: Vertical Style


import pandas as pd
import sqlite3 as sq

databaseName1 = "datawarehouse.db"
connection1 = sq.connect(databaseName1)

databaseName2 = "datamart.db"
connection2 = sq.connect(databaseName2)


SQLQuery1 = 'SELECT * FROM "Dim-BMI";'
InputData = pd.read_sql_query(SQLQuery1, connection1)

print("=== Input Data ===")
print(InputData)


SQLQuery2 = """
SELECT PersonID, Height, Weight, bmi, Indicator
FROM "Dim-BMI"
ORDER BY PersonID;
"""

ProcessData = pd.read_sql_query(SQLQuery2, connection1)


VerticalData = pd.melt(
    ProcessData,
    id_vars=["PersonID", "Indicator"],
    value_vars=["Height", "Weight", "bmi"],
    var_name="Attribute",
    value_name="Value"
)

print("============= Vertical Data ==============")
print(VerticalData)


VerticalData.to_sql(
    "Dim_BMI-Vertical",
    connection2,
    if_exists="replace",
    index=False
)


SQLQuery3 = 'SELECT * FROM "Dim_BMI-Vertical";'
OutputData = pd.read_sql_query(SQLQuery3, connection2)

print("================ Output Data ================")
print(OutputData)

connection1.close()
connection2.close()


