Practical 2B Conversion from different formats to HOURS format:  XML to HORUS. 


import pandas as pd
import xml.etree.cElementTree as et

Input_file = "Country_Code.xml"

with open(Input_file, "r", encoding="utf-8") as file:
    InputData = file.read()

print("=====================Input data=========================")
print(InputData)


def func(data):
    root = et.XML(data)
    all_records = []

    for child in root:
        record = {}

        for subchild in child:

            column_name = subchild.tag


            if column_name not in record:
                record[column_name] = subchild.text

        all_records.append(record)

    return pd.DataFrame(all_records)


OutputData = func(InputData)


OutputData.drop(
    labels=["ISO-2-CODE", "ISO-3-Code"],
    axis=1,
    inplace=True,
    errors="ignore"
)


OutputData.rename(
    columns={
        "Country": "Country_Name",
        "ISO-M49": "Country_Number"
    },
    inplace=True
)


OutputData.sort_values(
    by="Country_Name",
    ascending=False,
    inplace=True
)

print("=================Output_Data================")
print(OutputData)


OutputFile = "XML-HORUS-Country_code.csv"

OutputData.to_csv(OutputFile, index=False)

print("CSV file created successfully!")

