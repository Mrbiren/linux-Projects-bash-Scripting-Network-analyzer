Practical 4B    Retrieving Data: Data Pattern

import pandas as pd 
InputFile = "IP_DATA_ALL.csv" 
InputData = pd.read_csv(InputFile, low_memory=False, encoding="latin-1", 
dtype={ 
"ID": "int", 
"Country": "str", 
"Place.Name": "str", 
"Post.Code": "str", 
"Latitude": "float", 
"Longitude": "float", 
"First.IP.Number": "float", 
"Last.IP.Number": "float" 
}) 
print("---------- Input Data ----------") 
print(InputData) 
NewInputData = pd.DataFrame({"Country": InputData["Country"].unique()}) 
OutputData = pd.DataFrame({ 
"Country": NewInputData["Country"], 
"PatternCountry": NewInputData["Country"] 
}) 
oldchar = list("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ") 
newchar = ["A"] * len(oldchar) 
for r in range(OutputData.shape[0]): s = OutputData.loc[r, "PatternCountry"] 
s = str(s) 
for c in range(len(oldchar)): s = s.replace(oldchar[c], newchar[c]) 
for n in range(10): s = s.replace(str(n), "N") 
s = s.replace("-", "S") 
s = s.replace(".", "P") 
OutputData.loc[r, "PatternCountry"] = s 
print("---------- Output Data ----------") 
print(OutputData) 
OutputFile = "IP_DATA_ALL_NEW2.csv" 
OutputData.to_csv(OutputFile, index=False) 

