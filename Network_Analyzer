# 6A. Write program for Back propagation Algorithm

import math
def sigmoid(x):
return 1 / (1 + math.exp(-x))
def sigmoidDerivative(x):
return x * (1 - x)
x = [0, 1]
target = 1
w1 = 0.5
w2 = 0.5
learningRate = 0.5
for epoch in range(1000):
hidden = sigmoid(x[0] * w1)
output = sigmoid(hidden * w2)
error = target - output
outputDelta = error * sigmoidDerivative(output)
hiddenError = outputDelta * w2
hiddenDelta = hiddenError * sigmoidDerivative(hidden)
w2 = w2 + learningRate * outputDelta * hidden
w1 = w1 + learningRate * hiddenDelta * x[0]
hidden = sigmoid(x[0] * w1)
output = sigmoid(hidden * w2)
print("Final Weight w1 =", round(w1, 4))
print("Final Weight w2 =", round(w2, 4))
print("Final Output =", round(output, 4))


